{
  "name": "itmosoft/laravel-seller-verification",
  "description": "Seller verification workflows for Laravel applications, with polymorphic seller ownership, document metadata, review decisions, and expiry tracking.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "illuminate/contracts": "^12.0|^13.0",
    "illuminate/database": "^12.0|^13.0",
    "illuminate/filesystem": "^12.0|^13.0",
    "illuminate/support": "^12.0|^13.0"
  },
  "require-dev": {
    "orchestra/testbench": "^10.0|^11.0",
    "phpunit/phpunit": "^11.5|^12.0"
  },
  "autoload": {
    "psr-4": {
      "ITMOSOFT\\SellerVerification\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ITMOSOFT\\SellerVerification\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "ITMOSOFT\\SellerVerification\\SellerVerificationServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "version": "1.0.2"
}
